REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_CACHE_TTL=3600

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_db

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=products_production

EMBEDDING_MODEL=htdht/e5_finetuned_mnrl_v2
RERANKER_MODEL=nga2405/reranker
HF_HOME=./models
OPENAI_API_KEY=
GEMINI_API_KEY=

SPRING_BOOT_URL=http://nextgen-backend:8080

ANALYTICS_JWT_SECRET=your_analytics_jwt_secret
ANALYTICS_DEFAULT_USERNAME=admin
ANALYTICS_DEFAULT_EMAIL=admin@example.com
ANALYTICS_DEFAULT_PASSWORD=your_analytics_password
ANALYTICS_ALLOWED_IPS=

RABBITMQ_HOST=rabbitmq-rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_QUEUE=product.indexing.queue
RABBITMQ_EXCHANGE=product.exchange
RABBITMQ_ROUTING_KEY=product.indexing
